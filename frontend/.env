# Backend API port. Expo derives the development computer IP automatically.
EXPO_PUBLIC_API_PORT=5000
EXPO_PUBLIC_REQUEST_TIMEOUT=15000

# Web runs on the same computer as the backend.
#EXPO_PUBLIC_API_URL_WEB=http://localhost:5000/api

# Optional overrides. Leave commented during normal Expo LAN development.
# EXPO_PUBLIC_API_URL=http://192.168.1.41:5000/api
 EXPO_PUBLIC_API_URL_ANDROID=http://10.143.108.198:5000/api
# EXPO_PUBLIC_API_URL_IOS=http://192.168.1.41:5000/api
